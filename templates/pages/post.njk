{% extends "base.njk" %}
{% block title %}Post - ResearchRoomies{% endblock %}
{% block content %}
<div id="post-container" style="padding: 2em; text-align: center;">
  Loading post details...
</div>
<script>
  (function() {
    var parts = window.location.pathname.split('/');
    var postId = parts[parts.length - 1] || parts[parts.length - 2];
    var container = document.getElementById('post-container');
    if (postId && container) {
      container.setAttribute('hx-get', '/api/components/post/' + postId);
      container.setAttribute('hx-trigger', 'load');
      container.setAttribute('hx-swap', 'outerHTML');
      htmx.process(container);
    } else {
      container.innerHTML = 'Invalid Post ID.';
    }
  })();
</script>
{% endblock %}