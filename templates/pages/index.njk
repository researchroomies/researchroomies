---
title: Home
description: Find academics attending the same conference and share hotel rooms, rental cars, and other travel costs. Browse featured conferences or search by subject.
---
{% extends "base.njk" %}
{% block content %}
<div class="home-layout">
  <aside class="sidebar">
    <form action="/search" method="get" class="search-form">
      <input type="text" name="q" placeholder="Keywords" />
      <input type="text" name="conference" placeholder="Conference name" />
      <select name="tag" hx-get="/api/components/tag-options" hx-trigger="load" hx-swap="innerHTML">
        <option value="">Subject</option>
      </select>
      <input type="date" name="start" />
      <input type="date" name="end" />
      <button type="submit">Search</button>
    </form>
  </aside>
  <section class="main">
    <h2>Featured Conferences</h2>
    <div id="featured-conferences" 
         hx-get="/api/featured-conferences" 
         hx-trigger="load"
         hx-indicator="#loading-indicator">
      <div id="loading-indicator" class="htmx-indicator">
        Loading featured conferences...
      </div>
    </div>
  </section>
</div>
{% endblock %}