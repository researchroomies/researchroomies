---
title: Create a Post
description: Post a request to share a hotel room, rental car, or other conference travel costs with other academics attending the same conference.
---
{% extends "base.njk" %}
{% block content %}
<h2>Create a Post</h2>
<form action="/api/post" method="POST">
  <div id="auth-email-container" hx-get="/api/components/create-form-auth" hx-trigger="load" hx-swap="outerHTML">
    <label>Email</label>
    <input type="email" name="email" required placeholder="Checking authentication..." readonly />
  </div>

  <label>Conference</label>
  <select name="conference_id" hx-get="/api/components/conference-options" hx-trigger="load" hx-swap="innerHTML" onchange="document.getElementById('new-conference-fields').style.display = this.value === 'new' ? 'block' : 'none';">
    <option value="new">Create New Conference</option>
  </select>

  <div id="new-conference-fields" style="display: none;">
    <p class="form-notice">Please make sure you are not duplicating an already existing conference. Browse existing conferences before creating a new one.</p>
    <label>New Conference Name</label>
    <input type="text" name="new_conf_name" />
    <label>Start Date</label>
    <input type="date" name="new_conf_start" />
    <label>End Date</label>
    <input type="date" name="new_conf_end" />
    <label>City</label>
    <input type="text" name="new_conf_city" />
    <label>State</label>
    <input type="text" name="new_conf_state" />
    <label>Subjects</label>
    <select name="conf_tags" multiple size="6"
            hx-get="/api/components/tag-options?blank=0"
            hx-trigger="load"
            hx-swap="innerHTML"></select>
    <p class="field-hint">Hold Ctrl (or Cmd) to select more than one. Subjects let people find this conference from the nav and the search filter.</p>
  </div>

  <label>Post Title</label>
  <input type="text" name="title" required />

  <label>Description</label>
  <textarea name="description" rows="6" required></textarea>

  <p class="form-disclaimer">Please make sure you are only posting information that you are comfortable making publicly available.</p>
  <div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}"></div>
  <button type="submit">Submit</button>
</form>
{% endblock %}